<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:fitsSystemWindows="true">

    <!-- ===== TOPBAR ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#3E5C44"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBackPengaturan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="12dp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Pengaturan Akun"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== SECTION: Informasi Profil ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informasi Profil"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4A5550"
                android:layout_marginBottom="12dp" />

            <!-- Avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_bg_green_light"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ubah Foto"
                    android:textSize="12sp"
                    android:textColor="#B87333"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Card: Form Fields -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Nama Lengkap -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etNama"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:hint="Masukkan nama lengkap"
                        android:inputType="textPersonName"
                        android:layout_marginBottom="14dp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:hint="nama@email.com"
                        android:inputType="textEmailAddress"
                        android:layout_marginBottom="14dp" />

                    <!-- Nomor HP -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nomor HP"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etHp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:hint="08xx-xxxx-xxxx"
                        android:inputType="phone"
                        android:layout_marginBottom="14dp" />

                    <!-- Lokasi / Kota -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lokasi / Kota"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etLokasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:hint="Kota tempat tinggal" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECTION: Tentang Burung ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentang Burung"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4A5550"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Burung Andalan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/etJenisBurung"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:hint="Murai Batu, Perkutut, dll." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECTION: Tampilan Aplikasi ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tampilan Aplikasi"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4A5550"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Tema"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#4A5550"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinnerTema"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== TOMBOL SIMPAN ===== -->
            <Button
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#B87333"
                android:text="Simpan Perubahan"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
