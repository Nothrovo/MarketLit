<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar bulat -->
        <TextView
            android:id="@+id/tvBreederEmoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_bg_green_light"
            android:gravity="center"
            android:text="👨‍🌾"
            android:textSize="24sp" />

        <!-- Info Peternak -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvBreederName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pak Joko"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <TextView
                android:id="@+id/tvBreederFarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joko Murai Farm"
                android:textSize="12sp"
                android:textColor="@color/text_mid"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvBreederLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Jakarta Selatan"
                android:textSize="11sp"
                android:textColor="@color/text_light"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvBreederRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.9 (42 ulasan)"
                android:textSize="11sp"
                android:textColor="@color/amber"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Tombol Chat -->
        <Button
            android:id="@+id/btnChatBreeder"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Chat"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/g30b"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            app:cornerRadius="20dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
