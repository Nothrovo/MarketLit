<?xml version="1.0" encoding="utf-8"?>
<!-- item_chat_bubble.xml -->
<!-- Satu layout untuk kedua sisi: dokter (kiri) & user (kanan) -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp"
    android:paddingHorizontal="4dp">

    <!-- ── Bubble Dokter (kiri) ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/llBubbleDokter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentStart="true"
        android:maxWidth="260dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDokterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dokter"
            android:textSize="10sp"
            android:textColor="@color/text_light"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvPesanDokter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#1A1F1C"
            android:background="@drawable/bg_bubble_dokter"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/tvWaktuDokter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textSize="9sp"
            android:textColor="@color/text_light"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- ── Bubble User (kanan) ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/llBubbleUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:maxWidth="260dp"
        android:visibility="gone"
        android:gravity="end">

        <TextView
            android:id="@+id/tvPesanUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_bubble_user"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:lineSpacingMultiplier="1.3" />

        <TextView
            android:id="@+id/tvWaktuUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textSize="9sp"
            android:textColor="@color/text_light"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:gravity="end" />
    </LinearLayout>

</RelativeLayout>
