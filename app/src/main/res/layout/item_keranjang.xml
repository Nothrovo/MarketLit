<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/bg_white"
    android:padding="12dp"
    android:layout_margin="6dp">

    <!-- Emoji / Gambar Produk -->
    <TextView
        android:id="@+id/tvEmojiKeranjang"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="🐦"
        android:textSize="28sp"
        android:gravity="center"
        android:background="@color/g30ll" />

    <!-- Info produk -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvNamaKeranjang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvHargaKeranjang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="13sp"
            android:textColor="#3E5C44"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvPenjualKeranjang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Penjual"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Tombol Hapus -->
    <TextView
        android:id="@+id/btnHapusItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="🗑️"
        android:textSize="18sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
