<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- TOPBAR (Exactly 56dp Height with center_vertical elements) -->
    <RelativeLayout
        android:id="@+id/topbarMarket"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#3E5C44"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛍️ Marketplace"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="🔔"
                android:textSize="20sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/ivKeranjangMarket"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="🛒"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </RelativeLayout>

    <!-- SEARCH CONTAINER (Visually part of green header but separated to allow exactly 56dp Topbar) -->
    <LinearLayout
        android:id="@+id/searchContainerMarket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3E5C44"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:layout_below="@id/topbarMarket">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_searchbar_dark"
            android:hint="Cari burung, kandang, pakan…"
            android:textColorHint="#AAFFAACC"
            android:textColor="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="13sp"
            android:inputType="text"
            android:importantForAutofill="no" />
    </LinearLayout>

    <!-- FAB JUAL SEKARANG (di bawah, melayang tepat di atas bottom nav) -->
    <LinearLayout
        android:id="@+id/fabJual"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_fab_amber"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Jual Sekarang"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- KONTEN SCROLL (Mengisi seluruh area di bawah search bar) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchContainerMarket"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CHIP FILTER ROW -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_white"
                android:scrollbars="none"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/chipSemuaMkt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Semua"
                        android:background="@drawable/bg_chip_active"
                        android:textColor="@color/white"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipBurung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐦 Burung"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/g30b"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipPerlengkapan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💊 Perlengkapan"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/g30b"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipPakan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌾 Pakan"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/g30b"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipKandang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠 Kandang"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/g30b"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipPeternak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🌾 Peternak"
                        android:background="@drawable/bg_chip_inactive"
                        android:textColor="@color/g30b"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="12sp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- SECTION HEADER: jumlah produk + sort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvJumlahHasil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="11 produk tersedia"
                    android:textSize="13sp"
                    android:textColor="#757575" />

                <LinearLayout
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_sort"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⇅ Urutkan"
                        android:textSize="12sp"
                        android:textColor="@color/g30b"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- GRID LIST PRODUK -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMarketplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_burung_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>