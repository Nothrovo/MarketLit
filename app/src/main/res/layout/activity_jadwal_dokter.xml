<?xml version="1.0" encoding="utf-8"?>
<!-- activity_jadwal_dokter.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:fitsSystemWindows="true">

    <!-- ── Topbar ──────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topbarJadwal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/sage_dark"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBackJadwal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="←"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@android:color/transparent"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jadwal Praktik"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvNamaDokterJadwal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="drh. Budi Santoso"
                android:textSize="12sp"
                android:textColor="#A5D6A7" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── ScrollView Konten ───────────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card info dokter -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <!-- Avatar -->
                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar_green"
                        android:layout_marginEnd="14dp">

                        <TextView
                            android:id="@+id/tvAvatarJadwal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👨‍⚕️"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <!-- Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNamaInfoJadwal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="drh. Budi Santoso"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvSpesialisJadwal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spesialis Kicauan"
                            android:textSize="12sp"
                            android:textColor="@color/text_light" />

                        <TextView
                            android:id="@+id/tvRatingJadwal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★★★★★ 4.9"
                            android:textSize="11sp"
                            android:textColor="@color/amber" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Jadwal Mingguan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Jadwal Mingguan"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />

                    <!-- Senin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Senin"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09.00 – 12.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Selasa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selasa"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13.00 – 17.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Rabu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rabu"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09.00 – 13.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Kamis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kamis"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14.00 – 17.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Jumat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jumat"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08.00 – 12.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Sabtu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sabtu"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="09.00 – 11.00"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border" />

                    <!-- Minggu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Minggu"
                            android:textSize="13sp"
                            android:textColor="@color/text_light"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Libur"
                            android:textSize="13sp"
                            android:textColor="@color/text_light" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Tentang Konsultasi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/g30ll"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Tentang Konsultasi"
                        android:textSize="13sp"
                        android:textColor="@color/g30b"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Konsultasi dapat dilakukan secara online via chat atau telepon.\n• Untuk pemeriksaan fisik, kunjungan klinik tersedia sesuai jadwal.\n• Harap siapkan foto atau video kondisi burung Anda.\n• Tim kami akan menghubungi Anda untuk konfirmasi jadwal."
                        android:textSize="12sp"
                        android:textColor="@color/text_mid"
                        android:lineSpacingMultiplier="1.5" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- ── Tombol Jadwalkan Visit ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_white"
        android:padding="16dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnJadwalkanVisit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📅 Jadwalkan Visit"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accent"
            app:cornerRadius="25dp" />
    </LinearLayout>

</LinearLayout>
