<?xml version="1.0" encoding="utf-8"?>
<!-- item_dokter_card.xml -->
<!-- 1 baris card dokter di RecyclerView tab Dokter -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar bulat dengan emoji -->
        <LinearLayout
            android:id="@+id/llAvatarDokter"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_avatar_green">

            <TextView
                android:id="@+id/tvAvatarDokter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍⚕️"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Info dokter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaDokter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="drh. Budi Santoso"
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSpesialisDokter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spesialis Kicauan · 10 thn"
                android:textSize="11sp"
                android:textColor="@color/text_light"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/tvRatingDokter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★★★★★ 4.9 (128)"
                android:textSize="10sp"
                android:textColor="@color/amber" />
        </LinearLayout>

        <!-- Status + Tombol kanan -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvStatusDokter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Online"
                android:textSize="9sp"
                android:textColor="@color/g30b"
                android:background="@drawable/bg_badge_status_online"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="end" />

            <!-- Tombol Chat (aksi utama) -->
            <Button
                android:id="@+id/btnAksiDokter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Chat"
                android:textSize="10sp"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/g30b"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="4dp"
                app:cornerRadius="20dp" />

            <!-- Tombol Jadwal (selalu tampil, outline) -->
            <Button
                android:id="@+id/btnJadwalDokter"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="Jadwal"
                android:textSize="10sp"
                android:textColor="@color/g30b"
                android:background="@drawable/bg_btn_outline_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="20dp"
                app:strokeColor="@color/g30b"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>