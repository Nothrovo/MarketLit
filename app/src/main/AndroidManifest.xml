<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarketLit"
        tools:targetApi="31">

        <!-- Activity yang menjadi layar pertama (Splash) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Utama & Navigasi -->
        <activity
            android:name=".LandingActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Activity Autentikasi yang baru ditambahkan -->
        <activity android:name=".LoginEmailActivity" />
        <activity android:name=".RegisterActivity" />

        <!-- Activity Lainnya -->
        <activity android:name=".DetailLombaActivity" />
        <activity android:name=".ProfilActivity" />

        <!-- Activity Dokter Burung -->
        <activity android:name=".ChatDokterActivity" />
        <activity android:name=".JadwalDokterActivity" />
        <activity android:name=".PengaturanActivity" />
        <activity android:name=".RiwayatActivity" />

        <!-- Perhatikan ini, karena dia ada di dalam folder 'ui', kita tambahkan '.ui' -->
        <activity android:name=".ui.DetailBurungActivity" />

        <!-- Keranjang Belanja -->
        <activity android:name=".KeranjangActivity" />
        
        <!-- Profil Detail Peternak -->
        <activity android:name=".DetailPeternakActivity" />

    </application>

</manifest>